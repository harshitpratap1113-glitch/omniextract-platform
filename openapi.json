{
  "openapi": "3.0.3",
  "info": {
    "title": "OmniExtract Pro \u2014 Universal Media, Scraper & AI Micro-API",
    "description": "High-speed edge API to extract HD media streams from Instagram, YouTube, TikTok, convert web pages to LLM-ready markdown, and generate temporary inboxes.",
    "version": "2.4.0"
  },
  "servers": [
    {
      "url": "https://omniextract-pro-api.harshitpratap1113.workers.dev",
      "description": "Cloudflare Global Edge Server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health Probe & Endpoint Listing",
        "responses": {
          "200": {
            "description": "Returns system health and active edge location"
          }
        }
      }
    },
    "/api/v1/extract-social": {
      "post": {
        "summary": "Extract HD Video & MP3 Audio from Social Media",
        "description": "Supports Instagram Reels, YouTube Shorts, TikTok, Twitter/X, and Reddit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "example": "https://www.instagram.com/reel/C7xyz123/"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Clean stream download links and audio MP3 URL without watermarks."
          }
        }
      }
    },
    "/api/v1/web-to-markdown": {
      "post": {
        "summary": "Convert Any Webpage into LLM-Ready Clean Markdown",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "example": "https://en.wikipedia.org/wiki/Artificial_intelligence"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Markdown text stripped of ads/scripts with token estimate."
          }
        }
      }
    },
    "/api/v1/ai-polish": {
      "post": {
        "summary": "AI Script Emotion & SSML Pause Formatter",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "script": {
                    "type": "string",
                    "example": "Hello world. This is a dramatic movie script."
                  }
                },
                "required": [
                  "script"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSML enhanced text with cinematic breath and pause timings."
          }
        }
      }
    },
    "/api/v1/temp-email": {
      "get": {
        "summary": "Generate Anonymous Burner Email Address",
        "responses": {
          "200": {
            "description": "Disposable email address and temporary inbox URL."
          }
        }
      }
    }
  }
}